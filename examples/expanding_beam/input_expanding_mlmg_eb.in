###############################################################################
# Particle Beam(s)
###############################################################################
beam.npart = 10000  # outside tests, use 1e5 or more
beam.units = static
beam.kin_energy = 250.0
beam.charge = 1.0e-9
beam.particle = electron
beam.distribution = kurth6d
beam.lambdaX = 4.472135955e-4
beam.lambdaY = beam.lambdaX
beam.lambdaT = 9.12241869e-7
beam.lambdaPx = 0.0
beam.lambdaPy = 0.0
beam.lambdaPt = 0.0


###############################################################################
# Beamline: lattice elements and segments
###############################################################################
lattice.elements = monitor drift1 monitor
lattice.nslice = 6

drift1.type = drift
drift1.ds = 6.0

monitor.type = beam_monitor
monitor.backend = h5


###############################################################################
# Algorithms
###############################################################################
algo.particle_shape = 2
algo.space_charge = 3D
algo.poisson_solver = "multigrid"

# grounded elliptical beam pipe, far from the beam
eb.shape = elliptical
eb.aperture_x = 8.0e-3
eb.aperture_y = 8.0e-3

# transverse mesh spans the pipe aperture, longitudinal follows the beam
amr.n_cell = 128 128 40
amr.max_grid_size = 128  # one box per process: this example runs on a single process
geometry.prob_relative = 3.0
